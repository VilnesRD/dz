# /etc/nginx/sites-available/doczilla-bridge
#
# Новый блок ТОЛЬКО для bridge.vird.cloud.
# Существующие приложения на VPS не затрагиваются.
#
# УСТАНОВКА:
#   sudo cp doczilla-bridge /etc/nginx/sites-available/
#   sudo ln -s /etc/nginx/sites-available/doczilla-bridge /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d bridge.vird.cloud --email you@email.com --agree-tos --non-interactive

server {
    listen 80;
    server_name bridge.vird.cloud;

    # certbot использует этот путь для подтверждения домена
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name bridge.vird.cloud;

    # certbot допишет эти строки автоматически:
    # ssl_certificate     /etc/letsencrypt/live/bridge.vird.cloud/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/bridge.vird.cloud/privkey.pem;
    # include             /etc/letsencrypt/options-ssl-nginx.conf;
    # ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    # Проксируем на Docker-контейнер (порт 8010 из docker-compose.yml)
    location / {
        proxy_pass         http://127.0.0.1:8010;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # Б24 ждёт ответ максимум 5 сек — таймаут с запасом
        proxy_read_timeout    15s;
        proxy_connect_timeout  5s;
    }

    # Разрешаем встройку в iframe только с портала Б24
    add_header Content-Security-Policy "frame-ancestors https://crm-test.doczilla.pro";
    add_header X-Content-Type-Options nosniff;
}
